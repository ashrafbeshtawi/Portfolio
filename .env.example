# ------------------------------------------------------------------
# Runtime environment variables for the containerized app.
#
# The published image (ghcr.io/<owner>/portfolio) expects ALL of these
# as real environment variables (e.g. docker run -e / compose env).
# For local development docker-compose.yaml already provides them.
# ------------------------------------------------------------------

# dev | prod | test
APP_ENV=prod

# Random secret used for signing (sessions, CSRF). Generate one, e.g.:
#   php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change-me

# PostgreSQL connection (serverVersion must match your server)
DATABASE_URL="postgresql://portfolio:portfolio@db:5432/portfolio?serverVersion=18&charset=utf8"

# Credentials for the /admin control panel.
# The prod container REFUSES to start with an empty or default password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
