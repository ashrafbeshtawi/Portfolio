{% extends 'admin/base.html.twig' %}

{% block admin_title %}Project groups | Control Panel{% endblock %}

{% block admin_body %}
    <div class="admin-header">
        <h1>Project groups</h1>
        <a class="btn btn-primary" href="{{ path('admin_project_group_new') }}">New group</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Image</th>
                <th>Projects</th>
                <th>Sort order</th>
                <th class="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for group in groups %}
                <tr>
                    <td>{{ group.title }}</td>
                    <td>{{ group.imagePath ?: '—' }}</td>
                    <td>{{ group.projects|length }}</td>
                    <td>{{ group.sortOrder }}</td>
                    <td class="actions">
                        <a class="btn btn-small" href="{{ path('admin_project_group_edit', {id: group.id}) }}">Edit</a>
                        <form method="post" action="{{ path('admin_project_group_delete', {id: group.id}) }}"
                              onsubmit="return confirm('Delete this group and all its projects?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_project_group_' ~ group.id) }}">
                            <button class="btn btn-small btn-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="empty">No project groups yet.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
