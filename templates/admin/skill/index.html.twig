{% extends 'admin/base.html.twig' %}

{% block admin_title %}Skills | Control Panel{% endblock %}

{% block admin_body %}
    <div class="admin-header">
        <h1>Skills</h1>
        <a class="btn btn-primary" href="{{ path('admin_skill_new') }}">New skill</a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Link</th>
                <th>Sort order</th>
                <th class="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for skill in skills %}
                <tr>
                    <td>{{ skill.name }}</td>
                    <td>{{ skill.category.name }}</td>
                    <td>
                        {% if skill.url %}
                            <a href="{{ skill.url }}" target="_blank" rel="noopener noreferrer">link ↗</a>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>{{ skill.sortOrder }}</td>
                    <td class="actions">
                        <a class="btn btn-small" href="{{ path('admin_skill_edit', {id: skill.id}) }}">Edit</a>
                        <form method="post" action="{{ path('admin_skill_delete', {id: skill.id}) }}"
                              onsubmit="return confirm('Delete this skill?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_skill_' ~ skill.id) }}">
                            <button class="btn btn-small btn-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="empty">No skills yet.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
