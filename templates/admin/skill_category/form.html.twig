{% extends 'admin/base.html.twig' %}

{% block admin_title %}{{ title }} | Control Panel{% endblock %}

{% block admin_body %}
    <h1>{{ title }}</h1>
    <div class="admin-form">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn" href="{{ path('admin_skill_category_index') }}">Cancel</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
